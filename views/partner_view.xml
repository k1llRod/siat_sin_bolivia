<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
    	<!--
        extension a res_partner para adicionar campos del siat necesario del partner
        -->
        <record id="view_partner_form_inherit_nit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.nit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='website']" position="before">
                    <field name="cod_cliente_siat" required="1"/>
                    <field name="type_doc_identidad" required="1"/>
                </xpath>
            </field>
        </record>
    </data>
</openerp>