<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!--        GREGAMOS UNA EXTENSION AL VIEW DE CONFIGURACION DE CONTABILIDAD-->
        <record id="siat_view_account_config_settings" model="ir.ui.view">
	        <field name="name">siat.view.account.config.settings</field>
	        <field name="model">account.config.settings</field>
	        <field name="inherit_id" ref="account.view_account_config_settings"/>
	        <field name="arch" type="xml">
                <group name="accounting" position="after">
                    <group string= "SIAT">
                        <label string="Siat Default Payment Code"/>
                        <div>
                            <field name="siat_default_payment_code" class="oe_inline" />
                            <label for="siat_default_payment_code"/>
                        </div>
                        
                        <field name="siat_monto_max_cliente_sm"/>
                    </group>
                </group>
	        </field>
	    </record>

        <record id="view_general_configuration_mail_alias_domain" model="ir.ui.view">
            <field name="name">base.config.settings.mail.alias</field>
            <field name="model">base.config.settings</field>
            <field name="inherit_id" ref="base_setup.view_general_configuration"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='google']" position='before'>

                    <group string="Siat" name="siat">
                        <label for="id" string="Siat file xsd"/>
                        <div name="siat_file">
                            <div name="siat_file_xsd">
                                <field name="name_siat_file_xsd" invisible="1" />
                                <field name="siat_file_xsd" filename="name_siat_file_xsd"/>
                                <label for="siat_file_xsd"/>
                            </div>
                        </div>
                        <label for="id" string="Siat certificado .PK12"/>
                        <div>
                            <field name="siat_cetr" filename="name" class="oe_inline"/>
                        </div>
                        <label for="id" string="Siat contraseña"/>
                        <div>
                            <field name="siat_pass" filename="name" class="oe_inline"/>
                        </div>
                        <label for="id" string="Ruta archivo firma"/>
                        <div>
                            <field name="siat_route" filename="name" class="oe_inline"/>
                        </div>
                    </group>

                </xpath>

            </field>
        </record>
    </data>
</odoo>