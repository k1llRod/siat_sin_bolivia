<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <!-- Unidad de medida de odoo       -->
        <record id="siat_product_uom_form_view" model="ir.ui.view">
        <field name="name">siat.product.uom.form</field>
        <field name="model">product.uom</field>
        <field name="inherit_id" ref="product.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rounding']" position="after">
                <field name="siat_product_uom_id" required="1"/>
                <label for="siat_product_uom_id" string="Codigo Siat"/>
            </xpath>
        </field>
        </record>
    </data>
</openerp>