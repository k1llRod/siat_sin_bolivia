<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    	<!--
        extension a res_company para adicionar los datos necesarios para que la company pueda conectar a los servicios SOAP
        -->
        <record id="view_company_form_siat_specs_inherit" model="ir.ui.view">
            <field name="name">view.company.form.siat.specs.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='rml_header1']" position="before">
                    <label for="siat_nit" class="oe_edit_only"/>
                    <h1>
                        <field name="siat_nit" widget="char" class="oe_inline"/>
                    </h1>
                    <group>
                        <field name="siat_use_razon_social" groups="base.group_no_one"/>
                        <field name="siat_razon_social" attrs="{'invisible': [('siat_use_razon_social', '=', False)], 'required': [('siat_use_razon_social', '=', 'True')]}"/>
                    </group>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Siat Cuis">
                        <field name="siat_cuis_ids" context="{'default_company_id':id}" nolabel="1">
                            <tree >
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>

                    <page string="SIAT Technical spec" groups="base.group_no_one">
                        <group string="Data" colspan="2">
                            <field name="environment_code" required="1"/>
                            <field name="mode_constant" required="1"/>
                            <field name="system_code" required="1"/>
<!--                            <field name="cuis" required="1"/>-->
<!--                            <field name="branch_code" required="1"/>-->
<!--                            <field name="selling_point_code" required="1"/>-->
                        </group>
                        <group string="SERVICIO DE FACTURACION COMPUTARIZADA" colspan="6">
                            <field name="wsdl_computerized_billing" required="1" colspan="6"/>
                            <button name="test_wsdl_computerized_billing"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                        <group string="SERVICIO DE SINCRONIZACIÓN DE DATOS" colspan="6">
                            <field name="wsdl_data_sync" required="1" colspan="6"/>
                            <button name="test_wsdl_data_sync"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                        <group string="SERVICIO DE RECEPCIÓN DE COMPRAS" colspan="6">
                            <field name="wsdl_receipt_of_purchases" required="1" colspan="6"/>
                            <button name="test_wsdl_receipt_of_purchases"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                        <group string="SERVICIO DE OPERACIONES " colspan="6">
                            <field name="wsdl_operations" required="1" colspan="6"/>
                            <button name="test_wsdl_operations"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                        <group string="SERVICIO DE OBTENCIÓN DE CÓDIGOS" colspan="6">
                            <field name="wsdl_codes_procurements" required="1" colspan="6"/>
                            <button name="test_wsdl_codes_procurements"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                         <group string="FACTURA COMPRA-VENTA" colspan="6">
                            <field name="wsdl_in_out_invoice" required="1" colspan="6"/>
                            <button name="test_wsdl_in_out_invoice"
                                    string="Connexion Test"
                                    type="object"
                                    class="oe_link"/>
                        </group>
                        <group string="TOKEN DELEGADO" colspan="6">
                            <field name="delegated_token" required="1" colspan="6"/>
                        </group>
                        <group string="RUTA utilizada en QR" colspan="6">
                            <field name="lnk_st_qr" required="1" colspan="6"/>
                        </group>
                    </page>
                    <page string="SIAT">
                        <button name="action_consulta_punto_venta"
                                string="Consulta POS"
                                type="object"
                                class="btn-primary"/>
                        <group string="Sincronizacion" colspan="2">
                            <field name="siat_cuis_id"/>
                        </group>
                        <button name="action_sincronizar_lista_mensajes_servicios"
                                string="Lista de Mensajes"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_lista_productos_servicios"
                                string="Lista de Productos"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_eventos_significativos"
                                string="Eventos Significativos"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_motivo_anulacion"
                                string="Motivo Anulacion"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_pais_origen"
                                string="Pais Origen"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_documento_identidad"
                                string="Docuemnto Identidad"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_param_tipo_documento_sector"
                                string="Tipo Documento Sector"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_param_cod_actividad_documento_sector"
                                string="Actividades Documento Sector"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipo_emision"
                                string="Tipo Emision"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipo_habitacion"
                                string="Tipo Habitacion"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipo_metodo_pago"
                                string="Tipo Metodo Pago"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipo_moneda"
                                string="Tipo Moneda"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipo_punto_venta"
                                string="Tipo Punto Venta"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_tipos_factura"
                                string="Tipos Factura"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_parametrica_unidad_medida"
                                string="Unidad Medida"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_codigos_actividades"
                                string="Codigos Actividades"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_get_informationfecha_hora"
                                string="Fecha y Hora"
                                type="object"
                                class="btn-primary"/>

                        <button name="action_sincronizar_leyendas_facturas"
                                string="Leyendas de facturas"
                                type="object"
                                class="btn-primary"/>

                    </page>
                </xpath>
            </field>
        </record>

